@model Patient
<h2>Hasta Paneli</h2><p class="text-muted">Hoş geldin, @Model.User.FullName</p><div class="row g-3"><div class="col-lg-5"><div class="card p-3 shadow-sm"><h5>Randevu Al</h5><form asp-action="Book" method="post">@Html.AntiForgeryToken()<select name="doctorId" class="form-select mb-2" required><option value="">Doktor seç</option>@foreach(var b in (List<Branch>)ViewBag.Branches){foreach(var d in b.Doctors){<option value="@d.Id">@d.User.FullName - @b.Name</option>}}</select><input name="appointmentDate" type="date" class="form-control mb-2" min="@DateTime.Today.ToString("yyyy-MM-dd")" required><select name="appointmentTime" class="form-select mb-2"><option>09:00</option><option>10:30</option><option>13:30</option><option>15:00</option><option>16:30</option></select><input name="note" class="form-control mb-2" placeholder="Not"><button class="btn btn-primary w-100">Randevu Oluştur</button></form></div></div><div class="col-lg-7"><div class="card p-3 shadow-sm"><h5>Randevularım</h5><table class="table"><tr><th>Doktor</th><th>Tarih</th><th>Saat</th><th>Durum</th></tr>@foreach(var a in Model.Appointments){<tr><td>@a.Doctor.User.FullName</td><td>@a.AppointmentDate.ToString("dd.MM.yyyy")</td><td>@a.AppointmentTime</td><td>@a.Status</td></tr>}</table></div></div></div><div class="card p-3 shadow-sm mt-3"><h5>Sağlık Kayıtlarım</h5>@foreach(var r in Model.MedicalRecords){<div class="border-bottom py-2"><b>@r.Diagnosis</b> — @r.Treatment<br><small>Reçete: @r.Prescription</small></div>}</div>
