@model Doctor
<h2>Doktor Paneli</h2><p class="text-muted">@Model.Title • @Model.Branch.Name</p><div class="card p-3 shadow-sm mb-3"><h5>Randevular</h5><table class="table"><tr><th>Hasta</th><th>Tarih</th><th>Saat</th><th>Durum</th><th></th></tr>@foreach(var a in Model.Appointments){<tr><td>@a.Patient.User.FullName</td><td>@a.AppointmentDate.ToString("dd.MM.yyyy")</td><td>@a.AppointmentTime</td><td>@a.Status</td><td><form asp-action="UpdateAppointment" method="post" class="d-flex gap-1">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@a.Id"><select name="status" class="form-select form-select-sm"><option>Onaylandı</option><option>Tamamlandı</option><option>İptal</option></select><button class="btn btn-sm btn-primary">Kaydet</button></form></td></tr>}</table></div><div class="card p-3 shadow-sm"><h5>Hasta Kaydı Ekle</h5><form asp-action="AddRecord" method="post" class="row g-2">@Html.AntiForgeryToken()<div class="col-md-3"><select name="patientId" class="form-select">@foreach(var p in Model.Appointments.Select(a=>a.Patient).GroupBy(p=>p.Id).Select(g=>g.First())){<option value="@p.Id">@p.User.FullName</option>}</select></div><div class="col-md-3"><input name="diagnosis" class="form-control" placeholder="Tanı"></div><div class="col-md-3"><input name="treatment" class="form-control" placeholder="Tedavi"></div><div class="col-md-3"><input name="prescription" class="form-control" placeholder="Reçete / ilaç"></div><div class="col-12"><button class="btn btn-success">Kaydet</button></div></form></div>
