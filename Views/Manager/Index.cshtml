@model List<Appointment>
<h2>Müdür Paneli</h2><div class="row g-3 mb-3">@foreach(var x in new[]{("Kullanıcı",ViewBag.UserCount),("Doktor",ViewBag.DoctorCount),("Hasta",ViewBag.PatientCount),("Randevu",ViewBag.AppointmentCount),("Bölüm",ViewBag.BranchCount)}){<div class="col"><div class="card p-3 shadow-sm"><small>@x.Item1</small><h3>@x.Item2</h3></div></div>}</div><div class="card p-3 shadow-sm"><h5>Tüm Randevular</h5><table class="table"><tr><th>Hasta</th><th>Doktor</th><th>Bölüm</th><th>Tarih</th><th>Saat</th><th>Durum</th></tr>@foreach(var a in Model){<tr><td>@a.Patient.User.FullName</td><td>@a.Doctor.User.FullName</td><td>@a.Doctor.Branch.Name</td><td>@a.AppointmentDate.ToString("dd.MM.yyyy")</td><td>@a.AppointmentTime</td><td>@a.Status</td></tr>}</table></div>
