<!doctype html><html lang="tr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Hastane Randevu Sistemi</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link rel="stylesheet" href="~/css/site.css"></head><body><nav class="navbar navbar-dark bg-primary"><div class="container"><a class="navbar-brand fw-bold" asp-controller="Account" asp-action="Login">🏥 HRS</a>@if(User.Identity?.IsAuthenticated==true){<div class="text-white">@User.Identity.Name &nbsp; <a class="btn btn-light btn-sm" asp-controller="Account" asp-action="Logout">Çıkış</a></div>}</div></nav><main class="container py-4">@if(TempData["Success"]!=null){<div class="alert alert-success">@TempData["Success"]</div>}@if(TempData["Error"]!=null){<div class="alert alert-danger">@TempData["Error"]</div>}@RenderBody()</main></body></html>
